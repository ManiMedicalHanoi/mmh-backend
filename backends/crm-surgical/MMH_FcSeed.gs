function faSeed_(rows){
  var P = PropertiesService.getScriptProperties(); if(P.getProperty('FA_SEED') === FA_SEED_V) return 0;
  var by = {}; rows.forEach(function(r){ if(r.kenh !== 'Thầu') return; var k = faHk_(r) + '|' + String(r.grp).charAt(0); (by[k] = by[k] || []).push(r); });
  var G = { E:FC.GRP.E, D:FC.GRP.D, M:FC.GRP.M }, n = 0;
  FA_SEED.forEach(function(e){
    var L = by[fcHk_(e.h, fcProv_(e.p)) + '|' + G[e.g].charAt(0)] || []; if(!L.length) return;
    var fill = function(r, k, v){ if(v != null && v !== '' && !r[k]){ r[k] = v; return 1; } return 0; };
    L.forEach(function(r){
      var c = 0;
      if(e.g !== 'E') c += fill(r, 'stage', e.st);
      c += fill(r, 'prog', e.pr) + fill(r, 'cfg', e.cf) + fill(r, 'brand', e.br) + fill(r, 'crit', e.cr) + fill(r, 'note', e.no) + fill(r, 'chance', e.co);
      if(c){ r.src = (r.src ? r.src + ' · ' : '') + 'file FY68'; n++; }
    });
    if(e.g !== 'E' && e.q){
      Object.keys(e.q).forEach(function(t){
        var T = L.filter(function(r){ return r.type === t; }); if(!T.length) return;
        var each = Math.floor(e.q[t] / T.length);
        T.forEach(function(r, i){ if(String(r.man).indexOf('qty') >= 0) return; r.qty = each + (i === 0 ? e.q[t] - each * T.length : 0); r.man = r.man ? r.man + ',form' : 'form'; });
      });
    }
    if(e.g !== 'E' && e.s) L.forEach(function(r){ if(!r.start && String(r.man).indexOf('start') < 0) r.start = fcMonth_(e.s); });
  });
  P.setProperty('FA_SEED', FA_SEED_V);
  return n;
}
