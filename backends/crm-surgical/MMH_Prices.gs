var FA_PRICE_ = null;
/* mã ⇒ { per, kind, pack, box, name, from } — chuẩn hoá chữ hoa, bỏ khoảng trắng */
function faPrices_(){
  if(FA_PRICE_) return FA_PRICE_;
  FA_PRICE_ = {};
  FA_PRICE_ROWS.forEach(function(r){ FA_PRICE_[String(r[0]).toUpperCase()] = { per:r[4], kind:r[1], pack:r[2], box:r[3], name:r[5], from:r[6] }; });
  return FA_PRICE_;
}
/* giá / cái của 1 mã (hoặc nhóm "MSL22SH/MSL28SH" ⇒ mã đầu tiên có giá); không có ⇒ giá mã đại diện cùng loại (FC.REP), đánh dấu ước tính */
function faPriceOf_(code, type){
  var P = faPrices_(), parts = String(code || '').toUpperCase().replace(/\s+/g, '').split(/[\/,;+]/);
  for(var i = 0; i < parts.length; i++){ if(P[parts[i]]) return { per:P[parts[i]].per, code:parts[i], est:false }; }
  for(i = 0; i < parts.length; i++){                                     /* MSL28SH-2 · MST15MK(…) ⇒ bỏ phần đuôi lạ */
    var m = /^(M[A-Z]{2}\d{2}[A-Z]{0,4}|\d{4}[A-Z]?)/.exec(parts[i]); if(m && P[m[1]]) return { per:P[m[1]].per, code:m[1], est:false };
  }
  var rep = (typeof FC !== 'undefined' && FC.REP[type]) || '';
  if(rep && P[rep]) return { per:P[rep].per, code:rep, est:true };
  return { per:0, code:'', est:true };
}
/* sheet "BẢNG GIÁ NPP" (tra cứu) — ghi lại khi số dòng / phiên bản đổi */
function faPriceSheet_(book){
  var name = 'BẢNG GIÁ NPP', sh = book.getSheetByName(name), sig = FA_PRICE_ROWS.length + '|' + FA_PRICE_SRC.map(function(s){ return s.from; }).join(',');
  if(sh && PropertiesService.getScriptProperties().getProperty('FA_PRICE_SIG') === sig) return sh;
  if(!sh) sh = book.insertSheet(name);
  sh.clear();
  var hdr = ['Mã sản phẩm', 'Loại', 'Quy cách / hộp', 'Giá hộp (VND)', 'Giá / cái (VND)', 'Tên sản phẩm', 'Áp dụng từ'];
  var kn = { dao:'Dao nhãn khoa', chi:'Chỉ khâu', ghim:'Ghim da' };
  sh.getRange(1, 1, 1, hdr.length).setValues([hdr]).setFontWeight('bold').setBackground('#CFE2F3');
  sh.getRange(2, 1, FA_PRICE_ROWS.length, hdr.length).setValues(FA_PRICE_ROWS.map(function(r){ return ["'" + r[0], kn[r[1]] || r[1], r[2], r[3], r[4], r[5], r[6]]; }));
  sh.getRange(2, 4, FA_PRICE_ROWS.length, 2).setNumberFormat('#,##0');
  sh.setFrozenRows(1); sh.setColumnWidth(6, 420);
  var n = FA_PRICE_ROWS.length + 3;
  sh.getRange(n, 1, FA_PRICE_SRC.length + 1, 1).setValues([['Nguồn']].concat(FA_PRICE_SRC.map(function(s){ return [s.file + ' — áp dụng từ ' + s.from + ' (' + s.note + '). Giá chưa VAT, chưa phí vận chuyển.']; })));
  PropertiesService.getScriptProperties().setProperty('FA_PRICE_SIG', sig);
  return sh;
}
