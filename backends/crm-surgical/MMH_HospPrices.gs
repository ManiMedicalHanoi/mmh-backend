var HP_ = null;
/* mã ⇒ { kind, pack, box:{max,pubMin,priMin}, max, pubMin, priMin (/ cái), name, from } */
function hpPrices_(){
  if(HP_) return HP_;
  HP_ = {};
  HP_ROWS.forEach(function(r){
    HP_[String(r[0]).toUpperCase()] = { code:r[0], kind:r[1], pack:r[2], box:{ max:r[3], pubMin:r[4], priMin:r[5] },
      max:r[3] / r[2], pubMin:r[4] / r[2], priMin:r[5] / r[2], name:r[6], from:r[7] };
  });
  return HP_;
}
/* giá / cái của 1 mã (bỏ khoảng trắng, chữ hoa); không có ⇒ null */
function hpPriceOf_(code){
  var k = String(code || '').toUpperCase().replace(/\s+/g, '');
  return hpPrices_()[k] || null;
}
/* action fuHospPrice — chỉ phiên email công ty (giá nội bộ) */
function hpApi_(p){
  var me = fuMe_(p); if(me.err) return { ok:false, code:'AUTH', error:me.err };
  var want = String(p.codes || '').toUpperCase().replace(/\s+/g, '').split(/[,;]/).filter(String), P = hpPrices_(), out = [];
  (want.length ? want : Object.keys(P)).forEach(function(k){
    var x = P[k]; if(!x) return;
    out.push([x.code, x.kind, x.pack, x.box.max, x.box.pubMin, x.box.priMin, Math.round(x.max), Math.round(x.pubMin), Math.round(x.priMin), x.name, x.from]);
  });
  return { ok:true, cols:['code', 'kind', 'pack', 'boxMax', 'boxPubMin', 'boxPriMin', 'max', 'pubMin', 'priMin', 'name', 'from'], rows:out, src:HP_SRC,
           note:'Giá NPP bán cho bệnh viện, đã gồm VAT. max = tối đa · pubMin = tối thiểu BV công · priMin = tối thiểu BV tư (đ / cái).' };
}
/* sheet "BẢNG GIÁ NPP - BỆNH VIỆN" (tra cứu) — ghi lại khi số dòng / phiên bản đổi */
function hpPriceSheet_(book){
  var name = 'BẢNG GIÁ NPP - BỆNH VIỆN', sh = book.getSheetByName(name), sig = HP_ROWS.length + '|' + HP_SRC.map(function(s){ return s.from; }).join(',');
  if(sh && PropertiesService.getScriptProperties().getProperty('HP_PRICE_SIG') === sig) return sh;
  if(!sh) sh = book.insertSheet(name);
  sh.clear();
  var hdr = ['Mã sản phẩm', 'Loại', 'Quy cách / hộp', 'Giá tối đa BV (hộp)', 'Giá tối thiểu BV công (hộp)', 'Giá tối thiểu BV tư (hộp)',
             'Giá tối đa BV (cái)', 'Giá tối thiểu BV công (cái)', 'Giá tối thiểu BV tư (cái)', 'Tên / thông số', 'Áp dụng từ'];
  var kn = { dao:'Dao nhãn khoa', chi:'Chỉ khâu' };
  sh.getRange(1, 1, 1, hdr.length).setValues([hdr]).setFontWeight('bold').setBackground('#CFE2F3').setWrap(true);
  sh.getRange(2, 1, HP_ROWS.length, hdr.length).setValues(HP_ROWS.map(function(r){
    return ["'" + r[0], kn[r[1]] || r[1], r[2], r[3], r[4], r[5], Math.round(r[3] / r[2]), Math.round(r[4] / r[2]), Math.round(r[5] / r[2]), r[6], "'" + r[7]];
  }));
  sh.getRange(2, 4, HP_ROWS.length, 6).setNumberFormat('#,##0');
  sh.setFrozenRows(1); sh.setColumnWidth(10, 420);
  var n = HP_ROWS.length + 3;
  sh.getRange(n, 1, HP_SRC.length + 1, 1).setValues([['Nguồn (giá NPP bán cho bệnh viện, đã gồm VAT, chưa phí vận chuyển)']].concat(HP_SRC.map(function(s){ return [s.file + ' — áp dụng từ ' + s.from + ' (' + s.note + ')']; })));
  PropertiesService.getScriptProperties().setProperty('HP_PRICE_SIG', sig);
  return sh;
}
