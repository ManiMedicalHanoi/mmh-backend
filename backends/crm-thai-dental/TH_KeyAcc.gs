 * TH_KeyAcc.gs — v1.0 (26/11/2026) · CRM Thailand Dental — DDI key accounts ⇒ ACCOUNT TRACKING ▸ Key account (KPI C2-02)
 *
 * Yong (email 26/11/2026 "RE: Invitation: Meeting on CRM Approach and New KPI SOP" + comment in the draft file, sheet
 * "Copy of Territory & Accounts"): the DDI sell-out list FY66–FY67 (947 accounts) = TEMPORARY base of the distributor key accounts.
 * Giang chose: all 947. Yong should not type the list again ⇒ this file:
 *   · THK_DATA = the 947 accounts (name · Thai name · province · type · segment A/B/C · DDI sales rep) + the CRM match decided
 *     beforehand (M = matched · C = to confirm by Yong · N = not in CRM). No sales figures kept here.
 *     Matching: same name, same name without "Co., Ltd." / "dental clinic" / spacing, or a very close spelling of the same kind of place
 *     (hospital ≠ provincial public health office ≠ clinic); distributors (Promptdent, VRP, Siamdent…) never; the same name in
 *     several provinces / a doubtful spelling ⇒ "To confirm" (Yong ticks Key in Account tracking himself).
 *   · action thdKeyAcc&key=<last 8 chars of the Sheet ID>&op=status|dry|run
 *       run ⇒ sheet "DDI KEY ACCOUNTS" (the list + match, rewritten) · ACCOUNT TRACKING: matched rows ⇒ M Key account = Yes
 *       (an empty cell only — a "No" set by hand is kept), F Distributor = DDI and G Distributor sales rep = DDI rep when empty,
 *       K / L Updated = now / "DDI key list" · Script Property THK_ON = 1.
 *   · THK_ON ⇒ thkAuto_() after each acctList sync: a NEW account of CUSTOMER CODE whose name equals (same normalised name) a
 *     DDI account "not in CRM" is marked Yes too ⇒ the list never needs to be typed twice and does not duplicate.
 *************************************************************************************************/
var THK = { SH: 'DDI KEY ACCOUNTS', BY: 'DDI key list', DIST: 'DDI',
  HEAD: ['Distributor', 'DDI account name', 'Thai name', 'Province', 'Account type', 'Segment', 'DDI sales rep',
         'Match', 'CRM code', 'CRM account name', 'Note'] };
function thkNorm_(s){
  s = String(s || '').toLowerCase().replace(/univ\./g, 'university').replace(/&/g, ' and ').replace(/co\.,/g, 'co ');
  return s.replace(/[^a-z0-9฀-๿]+/g, ' ').replace(/\s+/g, ' ').trim();
}
function thkStLabel_(st){ return st === 'M' ? 'Matched' : (st === 'C' ? 'To confirm' : 'Not in CRM'); }
/* CRM names / codes to mark: matched rows of THK_DATA */
function thkTargets_(){
  var byCode = {}, byName = {};
  THK_DATA.forEach(function(r){
    if(r[6] !== 'M') return;
    r[7].forEach(function(m){ if(m[0] && m[0].indexOf('?') < 0) byCode[m[0]] = r; byName[picKey_(m[1])] = r; });
  });
  return { byCode: byCode, byName: byName };
}
/* DDI accounts not in CRM, by normalised name (only names that appear once in the DDI list) */
function thkLater_(){
  var cnt = {}, out = {};
  THK_DATA.forEach(function(r){ var k = thkNorm_(r[0]); cnt[k] = (cnt[k] || 0) + 1; });
  THK_DATA.forEach(function(r){ var k = thkNorm_(r[0]); if(r[6] === 'N' && k && cnt[k] === 1) out[k] = r; });
  return out;
}
function thkSheet_(){
  var book = ss_(), s = book.getSheetByName(THK.SH);
  if(!s){
    s = book.insertSheet(THK.SH, book.getNumSheets());
    s.setFrozenRows(1); s.setFrozenColumns(2);
    [80, 300, 260, 130, 130, 70, 110, 100, 110, 300, 260].forEach(function(w, i){ try{ s.setColumnWidth(i + 1, w); }catch(e){} });
  }
  return s;
}
function thkWriteList_(){
  var s = thkSheet_(), rows = [THK.HEAD];
  THK_DATA.forEach(function(r){
    var codes = r[7].map(function(m){ return m[0]; }).join('\n'), names = r[7].map(function(m){ return m[1]; }).join('\n');
    rows.push([THK.DIST, r[0], r[1], r[2], r[3], r[4], r[5], thkStLabel_(r[6]), r[6] === 'N' ? '' : codes, r[6] === 'N' ? '' : names,
               r[6] === 'C' ? (r[8] || '') + ' — tick "Key" in Account tracking if it is the same place' :
               (r[6] === 'N' ? 'Marked automatically when an account with this name is added to the CRM' : '')]);
  });
  s.clearContents();
  if(s.getMaxRows() < rows.length + 5) s.insertRowsAfter(s.getMaxRows(), rows.length + 5 - s.getMaxRows());
  s.getRange(1, 1, rows.length, THK.HEAD.length).setValues(rows);
  s.getRange(1, 1, 1, THK.HEAD.length).setFontWeight('bold').setBackground('#003047').setFontColor('#FFFFFF').setWrap(true);
  try{ s.getRange(1, 1).setNote('Source: DDI sell-out FY66–FY67 (Yong, sheet "Copy of Territory & Accounts" of the draft file) — temporary base of the DDI key accounts (KPI C2-02). Rewritten by the system: edit Key account in ACCOUNT TRACKING, not here.'); }catch(e){}
  return rows.length - 1;
}
/* mark ACCOUNT TRACKING rows; pick(row) ⇒ THK_DATA row or null. dry ⇒ no write */
function thkMark_(s, pick, dry){
  var rows = acmRead_(s), last = s.getLastRow(), n = last - ACM.DATA + 1, out = { yes: 0, dist: 0, dsr: 0, keptNo: 0, names: [] };
  if(n < 1) return out;
  var col = function(f){ return ACM.F.indexOf(f) + 1; };
  var F = s.getRange(ACM.DATA, col('dist'), n, 2).getValues(), K = s.getRange(ACM.DATA, col('at'), n, 3).getValues();
  var touched = false, now = new Date();
  rows.forEach(function(r){
    var d = pick(r); if(!d) return;
    var i = r._row - ACM.DATA, ch = false;
    if(/^no$/i.test(str_(K[i][2]))){ out.keptNo++; return; }
    if(!acmYes_(K[i][2])){ K[i][2] = 'Yes'; out.yes++; ch = true; out.names.push(str_(r.name)); }
    if(!str_(F[i][0])){ F[i][0] = THK.DIST; out.dist++; ch = true; }
    if(!str_(F[i][1]) && str_(d[5])){ F[i][1] = str_(d[5]); out.dsr++; ch = true; }
    if(ch){ K[i][0] = now; K[i][1] = THK.BY; touched = true; }
  });
  if(touched && !dry){
    s.getRange(ACM.DATA, col('dist'), n, 2).setValues(F);
    s.getRange(ACM.DATA, col('at'), n, 3).setValues(K);
    SpreadsheetApp.flush();
  }
  if(out.names.length > 60) out.names = out.names.slice(0, 60).concat(['…']);
  return out;
}
function thkPickMatched_(){
  var T = thkTargets_();
  return function(r){ return (str_(r.code) && T.byCode[str_(r.code)]) || T.byName[picKey_(r.name)] || null; };
}
/* after each acctList sync (THK_ON): accounts whose name equals a DDI account "not in CRM" (new accounts added later) */
function thkAuto_(){
  if(props_().getProperty('THK_ON') !== '1') return null;
  var later = thkLater_(), s = acmSheet_();
  var r = thkMark_(s, function(x){ return later[thkNorm_(x.name)] || null; }, false);
  if(r.yes) try{ log_('System', 'update', 'ACCOUNT TRACKING', 'DDI key list', 'Key account = Yes · ' + r.names.join(', ').slice(0, 300), ''); }catch(e){}
  return r;
}
function thkApi_(p){
  var key = str_(p.key), id = ss_().getId();
  if(!key || key !== id.slice(-8)) return { ok: false, error: 'key?' };
  var op = str_(p.op) || 'status', out = { ok: true, op: op };
  var cnt = { M: 0, C: 0, N: 0 }; THK_DATA.forEach(function(r){ cnt[r[6]]++; });
  out.list = { total: THK_DATA.length, matched: cnt.M, toConfirm: cnt.C, notInCrm: cnt.N };
  out.on = props_().getProperty('THK_ON') === '1';
  if(op === 'status'){
    var rows = acmRead_(acmSheet_());
    out.tracking = { rows: rows.length, keyYes: rows.filter(function(r){ return acmYes_(r.key); }).length,
                     keyNo: rows.filter(function(r){ return /^no$/i.test(str_(r.key)); }).length,
                     byDDIList: rows.filter(function(r){ return str_(r.by) === THK.BY; }).length };
    out.sheet = !!ss_().getSheetByName(THK.SH);
    return out;
  }
  if(op !== 'dry' && op !== 'run') return { ok: false, error: 'op = status | dry | run' };
  var L = lock_();
  try{
    acmSync_();
    var s = acmSheet_(), dry = op === 'dry';
    out.matched = thkMark_(s, thkPickMatched_(), dry);
    var later = thkLater_();
    out.autoNow = thkMark_(s, function(x){ return later[thkNorm_(x.name)] || null; }, dry);
    if(!dry){ out.listRows = thkWriteList_(); props_().setProperty('THK_ON', '1'); }
  } finally { L.releaseLock(); }
  if(!dry) try{ log_('System', 'update', 'ACCOUNT TRACKING', 'DDI key list', 'Key account = Yes: ' + (out.matched.yes + out.autoNow.yes) + ' accounts', ''); }catch(e){}
  return out;
}
